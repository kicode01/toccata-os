[Unit]
Description=Toccata OS Sovereign Kiosk Desktop Session
After=systemd-user-sessions.service toccata-bridge.service seatd.service
Conflicts=getty@tty1.service
Wants=toccata-bridge.service seatd.service

[Service]
User=toccata
Group=toccata
PAMName=login
RuntimeDirectory=toccata
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/toccata
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Toccata
Environment=WLR_BACKENDS=drm
Environment=LIBSEAT_BACKEND=seatd
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
Environment=WLR_RENDERER=gles2
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=WLR_NO_HARDWARE_CURSORS=1
ExecStart=/usr/local/bin/toccata-kiosk-session
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target
