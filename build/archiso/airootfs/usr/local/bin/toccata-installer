        self.btn_next.clicked.connect(self.next_step)
        self.nav_bar.addWidget(self.btn_next)

        rp_layout.addLayout(self.nav_bar)
        container_layout.addWidget(right_panel)

        self.update_sidebar_step(0)

    def update_sidebar_step(self, active_idx):
        for idx, (dot, lbl) in enumerate(self.step_labels):
            if idx == active_idx:
                dot.setStyleSheet("color: #007aff; background: transparent;")
                lbl.setStyleSheet("color: #1d1d1f; font-weight: bold; background: transparent;")
            elif idx < active_idx:
                dot.setStyleSheet("color: #34c759; background: transparent;")
                lbl.setStyleSheet("color: #48484a; background: transparent;")
            else:
                dot.setStyleSheet("color: rgba(0, 0, 0, 0.25); background: transparent;")
                lbl.setStyleSheet("color: #86868b; background: transparent;")

