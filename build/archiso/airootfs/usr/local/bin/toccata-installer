    # PAGE 2: Target Disk
    def create_disk_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setSpacing(12)

        title = QLabel("Select Installation Destination")
        title.setFont(QFont("Segoe UI, Inter", 16, QFont.Weight.Bold))
        title.setStyleSheet("color: #1d1d1f;")
        layout.addWidget(title)

        desc = QLabel("Choose the storage device for Toccata OS. The selected drive will be formatted with GPT and Btrfs.")
        desc.setFont(QFont("Segoe UI, Inter", 10))
        desc.setStyleSheet("color: #6e6e73;")
        layout.addWidget(desc)
        layout.addSpacing(6)

        # Storage Target Cards
        self.card_container = QWidget()
        cards_layout = QVBoxLayout(self.card_container)
        cards_layout.setContentsMargins(0, 0, 0, 0)
        cards_layout.setSpacing(10)

        disks = self.get_disks()
        for idx, (name, size, model) in enumerate(disks):
            card = DiskCard(name, size, model, is_selected=(idx == 0))
            cards_layout.addWidget(card)

        layout.addWidget(self.card_container)

        # Btrfs Storage Architecture Specs Callout (Light Mode)
        specs = QFrame()
        specs.setObjectName("SpecsCard")
        specs.setStyleSheet("""
            QFrame#SpecsCard {
                background: #f4f5f7;
                border: 1px solid rgba(0, 0, 0, 0.08);
                border-radius: 10px;
                padding: 10px;
            }
            QLabel {
                border: none;
                color: #6e6e73;
                font-size: 11px;
                background: transparent;
            }
        """)
        s_layout = QVBoxLayout(specs)
        s_layout.setSpacing(4)
        s_layout.addWidget(QLabel("Partition Layout: EFI System (512MB) + Btrfs System Volume (Remaining)"))
        s_layout.addWidget(QLabel("Subvolumes: @ (root, ZSTD:3) • @home (user files) • @snapshots (Snapper)"))
        s_layout.addWidget(QLabel("Bootloader: systemd-boot with automatic kernel fallback entries"))
        layout.addWidget(specs)

        layout.addStretch()
        return page

    def get_disks(self):
        disks = []
        try:
            res = subprocess.run(["lsblk", "-d", "-n", "-o", "NAME,SIZE,MODEL"], capture_output=True, text=True)
            for line in res.stdout.strip().split("\n"):
                parts = line.split(None, 2)
                if len(parts) >= 2 and not parts[0].startswith("loop"):
                    model = parts[2] if len(parts) > 2 else "PCIe NVMe SSD"
                    disks.append((parts[0], parts[1], model))
        except Exception:
            pass
        if not disks:
            disks = [
                ("nvme0n1", "512 GB", "Samsung 990 Pro NVMe PCIe 4.0"),
                ("sda", "1000 GB", "Crucial MX500 SATA SSD"),
            ]
        return disks

