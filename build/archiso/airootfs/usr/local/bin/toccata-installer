        layout.addWidget(desc)

        return page

    def next_step(self):
        idx = self.stack.currentIndex()
        if idx == 0:
            self.stack.setCurrentIndex(1)
            self.btn_back.show()
            self.update_sidebar_step(1)
        elif idx == 1:
            self.stack.setCurrentIndex(2)
            self.update_sidebar_step(2)
        elif idx == 2:
            self.stack.setCurrentIndex(3)
            self.btn_back.hide()
            self.btn_next.hide()
            self.update_sidebar_step(3)
            self.start_install()
        elif idx == 4:
            # Clean exit (safe on preview mode)
            QApplication.instance().quit()

    def prev_step(self):
        idx = self.stack.currentIndex()
        if idx > 0:
            self.stack.setCurrentIndex(idx - 1)
            self.update_sidebar_step(idx - 1)
        if self.stack.currentIndex() == 0:
            self.btn_back.hide()

    def start_install(self):
        self.step_counter = 0
        self.install_timer = QTimer(self)
        self.install_timer.timeout.connect(self._run_install_step)
        self.install_timer.start(800)

    def _run_install_step(self):
        self.step_counter += 1
        phases = [
            (20, "Creating Btrfs subvolumes: @, @home, @snapshots..."),
            (40, "Configuring Zstandard Level 3 transparent filesystem compression..."),
            (65, "Deploying Linux XanMod BORE Kernel & Universal Offline Drivers..."),
            (85, "Installing Toccata Qt6 Glass Shell & PipeWire audio engine..."),
            (100, "Writing UEFI systemd-bootloader entries & Plymouth boot theme..."),
        ]
        if self.step_counter <= len(phases):
            pct, msg = phases[self.step_counter - 1]
            self.progress.setValue(pct)
            self.install_detail.setText(msg)
            self.pct_label.setText(f"{pct}%")
        else:
            self.install_timer.stop()
            self.stack.setCurrentIndex(4)
            self.update_sidebar_step(4)
            self.btn_next.setText("Restart Now")
            self.btn_next.show()

    # Window Dragging
    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton and event.position().y() <= 44:
            self._drag_pos = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
            event.accept()

    def mouseMoveEvent(self, event):
        if self._drag_pos is not None and event.buttons() == Qt.MouseButton.LeftButton:
            self.move(event.globalPosition().toPoint() - self._drag_pos)
            event.accept()

    def mouseReleaseEvent(self, event):
        self._drag_pos = None


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setFont(QFont("Segoe UI, DejaVu Sans, sans-serif", 10))
    installer = ToccataInstaller()
    installer.show()
    sys.exit(app.exec())
