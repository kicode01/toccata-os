#!/usr/bin/env python3
"""
Toccata OS 1.0 - macOS Sequoia Light Mode Setup Assistant & System Installer
Luminous Apple porcelain palette, bespoke vector iconography, left-rail navigation, and interactive NVMe disk cards.
"""

import sys
import os
import subprocess
from PyQt6.QtCore import Qt, QTimer, QRectF, QPointF
from PyQt6.QtGui import (
    QFont, QColor, QPainter, QBrush, QPen, QLinearGradient, QPainterPath
)
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton,
    QStackedWidget, QLineEdit, QProgressBar, QFrame
)

class VectorIcon(QWidget):
    """Bespoke vector icon renderer drawn via anti-aliased QPainter (Zero Emojis)."""
    def __init__(self, icon_type="brand", size=48, parent=None):
        super().__init__(parent)
        self.icon_type = icon_type
        self.setFixedSize(size, size)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()

        if self.icon_type == "brand":
            # Apple squircle container with deep blue-to-indigo gradient
            grad = QLinearGradient(0, 0, w, h)
            grad.setColorAt(0, QColor(0, 122, 255))
            grad.setColorAt(1, QColor(88, 86, 214))
            p.setBrush(QBrush(grad))
            p.setPen(QPen(QColor(255, 255, 255, 60), 1.2))
            p.drawRoundedRect(QRectF(2, 2, w - 4, h - 4), w * 0.26, h * 0.26)

            # Elegant audio waveform / tuning fork motif
            p.setPen(QPen(QColor(255, 255, 255), 2.5, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            cx, cy = w / 2, h / 2
            bars = [-12, -6, 0, 6, 12]
            heights = [8, 14, 20, 14, 8]
            for dx, bh in zip(bars, heights):
                p.drawLine(QPointF(cx + dx, cy - bh / 2), QPointF(cx + dx, cy + bh / 2))

        elif self.icon_type == "disk":
            # Crisp metallic NVMe / SSD Drive Symbol for Light Mode
            p.setBrush(QBrush(QColor(240, 242, 246)))
            p.setPen(QPen(QColor(0, 0, 0, 45), 1.2))
            p.drawRoundedRect(QRectF(4, 8, w - 8, h - 16), 6, 6)

            # Drive activity indicator LED
            p.setBrush(QBrush(QColor(0, 122, 255)))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawEllipse(QPointF(w - 14, h / 2), 3, 3)

            # Bus tracks
            p.setPen(QPen(QColor(110, 110, 120), 1.5))
            p.drawLine(QPointF(12, h / 2 - 3), QPointF(w - 24, h / 2 - 3))
            p.drawLine(QPointF(12, h / 2 + 3), QPointF(w - 32, h / 2 + 3))

        elif self.icon_type == "complete":
            # Apple green success checkmark inside circle
            p.setBrush(QBrush(QColor(52, 199, 89)))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawEllipse(QRectF(4, 4, w - 8, h - 8))

            p.setPen(QPen(QColor(255, 255, 255), 3, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
            p.drawLine(QPointF(w * 0.3, h * 0.52), QPointF(w * 0.44, h * 0.68))
            p.drawLine(QPointF(w * 0.44, h * 0.68), QPointF(w * 0.72, h * 0.36))


class SelectionBadge(QWidget):
    """Bespoke Apple-style circular checkmark indicator."""
    def __init__(self, is_selected=False, parent=None):
        super().__init__(parent)
        self.is_selected = is_selected
        self.setFixedSize(22, 22)

    def set_selected(self, selected):
        self.is_selected = selected
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()

        if self.is_selected:
            # Filled Apple blue circle
            p.setBrush(QBrush(QColor(0, 122, 255)))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawEllipse(QRectF(1, 1, w - 2, h - 2))

            # Crisp white checkmark
            p.setPen(QPen(QColor(255, 255, 255), 2.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
            p.drawLine(QPointF(w * 0.28, h * 0.52), QPointF(w * 0.44, h * 0.68))
            p.drawLine(QPointF(w * 0.44, h * 0.68), QPointF(w * 0.72, h * 0.36))
        else:
            # Muted hollow circle for Light Mode
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(QColor(0, 0, 0, 50), 1.5))
            p.drawEllipse(QRectF(1.5, 1.5, w - 3, h - 3))


class DiskCard(QFrame):
    """Interactive NVMe / SATA Storage Target Card (Apple Light Mode)."""
    def __init__(self, name, size, model, is_selected=False, parent=None):
        super().__init__(parent)
        self.setObjectName("DiskCard")
        self.is_selected = is_selected
        self.setFixedHeight(72)
        self.setCursor(Qt.CursorShape.PointingHandCursor)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(14, 10, 16, 10)
        layout.setSpacing(14)

        # Vector Disk Icon
        layout.addWidget(VectorIcon("disk", 38))

        # Drive Info
        info_layout = QVBoxLayout()
        info_layout.setSpacing(2)
        info_layout.setAlignment(Qt.AlignmentFlag.AlignVCenter)

        self.title_lbl = QLabel(f"{model} ({size})")
        self.title_lbl.setFont(QFont("Segoe UI, Inter", 11, QFont.Weight.DemiBold))
        info_layout.addWidget(self.title_lbl)

        self.sub_lbl = QLabel(f"Device: /dev/{name} • Target: Btrfs (@, @home, @snapshots)")
        self.sub_lbl.setFont(QFont("Segoe UI, Inter", 9))
        info_layout.addWidget(self.sub_lbl)

        layout.addLayout(info_layout)
        layout.addStretch()

        self.badge = SelectionBadge(is_selected)
        layout.addWidget(self.badge)

        self.update_style()

    def set_selected(self, selected):
        self.is_selected = selected
        self.badge.set_selected(selected)
        self.update_style()

    def update_style(self):
        if self.is_selected:
            self.setStyleSheet("""
                QFrame#DiskCard {
                    background-color: #f0f7ff;
                    border: 1.5px solid #007aff;
                    border-radius: 12px;
                }
                QLabel {
                    border: none;
                    background: transparent;
                    color: #1d1d1f;
                }
            """)
            self.sub_lbl.setStyleSheet("border: none; background: transparent; color: #0066cc;")
        else:
            self.setStyleSheet("""
                QFrame#DiskCard {
                    background-color: #ffffff;
                    border: 1px solid rgba(0, 0, 0, 0.10);
                    border-radius: 12px;
                }
                QFrame#DiskCard:hover {
                    background-color: #fafbfc;
                    border: 1px solid rgba(0, 0, 0, 0.22);
                }
                QLabel {
                    border: none;
                    background: transparent;
                    color: #1d1d1f;
                }
            """)
            self.sub_lbl.setStyleSheet("border: none; background: transparent; color: #86868b;")

    def mousePressEvent(self, event):
        self.set_selected(True)
        if self.parent():
            for sibling in self.parent().findChildren(DiskCard):
                if sibling != self:
                    sibling.set_selected(False)
        super().mousePressEvent(event)


class ToccataInstaller(QWidget):
    """macOS Sequoia Light Mode Setup Assistant."""
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Toccata OS Setup Assistant")
        self.resize(840, 520)
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)

        self._drag_pos = None
        self.setup_ui()

    def setup_ui(self):
        root = QVBoxLayout(self)
        root.setContentsMargins(10, 10, 10, 10)

        self.container = QFrame(self)
        self.container.setObjectName("Container")
        self.container.setStyleSheet("""
            QFrame#Container {
                background-color: #fbfbfd;
                border: 1px solid rgba(0, 0, 0, 0.14);
                border-radius: 16px;
            }
        """)
        root.addWidget(self.container)

        container_layout = QHBoxLayout(self.container)
        container_layout.setContentsMargins(0, 0, 0, 0)
        container_layout.setSpacing(0)

        # 1. Left Rail / Steps Sidebar (Apple Aluminum Mist)
        sidebar = QFrame()
        sidebar.setFixedWidth(210)
        sidebar.setStyleSheet("""
            QFrame {
                background-color: #f2f3f6;
                border-top-left-radius: 16px;
                border-bottom-left-radius: 16px;
                border-right: 1px solid rgba(0, 0, 0, 0.08);
            }
        """)
        sb_layout = QVBoxLayout(sidebar)
        sb_layout.setContentsMargins(18, 20, 18, 20)
        sb_layout.setSpacing(14)

        # Inset Traffic Lights
        tb_lights = QHBoxLayout()
        tb_lights.setSpacing(8)
        self.btn_close = QPushButton()
        self.btn_close.setFixedSize(12, 12)
        self.btn_close.setStyleSheet("background: #ff5f56; border: 1px solid #e0443e; border-radius: 6px;")
        self.btn_close.clicked.connect(self.close)

        btn_min = QPushButton()
        btn_min.setFixedSize(12, 12)
        btn_min.setStyleSheet("background: #ffbd2e; border: 1px solid #dea123; border-radius: 6px;")

        btn_zoom = QPushButton()
        btn_zoom.setFixedSize(12, 12)
        btn_zoom.setStyleSheet("background: #27c93f; border: 1px solid #1aab29; border-radius: 6px;")

        tb_lights.addWidget(self.btn_close)
        tb_lights.addWidget(btn_min)
        tb_lights.addWidget(btn_zoom)
        tb_lights.addStretch()
        sb_layout.addLayout(tb_lights)
        sb_layout.addSpacing(10)

        # Brand Monogram in Sidebar
        sb_brand = QHBoxLayout()
        sb_brand.addWidget(VectorIcon("brand", 32))
        sb_title = QLabel("Toccata OS")
        sb_title.setFont(QFont("Segoe UI, Inter", 13, QFont.Weight.Bold))
        sb_title.setStyleSheet("color: #1d1d1f; background: transparent; padding-left: 4px;")
        sb_brand.addWidget(sb_title)
        sb_brand.addStretch()
        sb_layout.addLayout(sb_brand)
        sb_layout.addSpacing(16)

        # Vertical Step Indicators
        self.step_labels = []
        steps = [
            "Welcome",
            "Target Disk",
            "User Profile",
            "Installation",
            "Ready"
        ]
        for idx, title in enumerate(steps):
            row = QHBoxLayout()
            row.setSpacing(10)

            dot = QLabel("●")
            dot.setFont(QFont("Segoe UI", 8))
            dot.setStyleSheet("color: rgba(0, 0, 0, 0.25); background: transparent;")

            lbl = QLabel(title)
            lbl.setFont(QFont("Segoe UI, Inter", 10, QFont.Weight.Medium))
            lbl.setStyleSheet("color: #86868b; background: transparent;")

            row.addWidget(dot)
            row.addWidget(lbl)
            row.addStretch()

            self.step_labels.append((dot, lbl))
            sb_layout.addLayout(row)

        sb_layout.addStretch()

        version_lbl = QLabel("Version 1.0 (x86_64)")
        version_lbl.setFont(QFont("Segoe UI, Inter", 9))
        version_lbl.setStyleSheet("color: #86868b; background: transparent;")
        sb_layout.addWidget(version_lbl)

        container_layout.addWidget(sidebar)

        # 2. Right Content Area (Porcelain White)
        right_panel = QWidget()
        right_panel.setStyleSheet("background: transparent;")
        rp_layout = QVBoxLayout(right_panel)
        rp_layout.setContentsMargins(36, 28, 36, 28)
        rp_layout.setSpacing(16)

        self.stack = QStackedWidget()
        self.stack.addWidget(self.create_welcome_page())
        self.stack.addWidget(self.create_disk_page())
        self.stack.addWidget(self.create_user_page())
        self.stack.addWidget(self.create_install_page())
        self.stack.addWidget(self.create_finish_page())
        rp_layout.addWidget(self.stack)

        # Bottom Button Bar
        self.nav_bar = QHBoxLayout()
        self.btn_back = QPushButton("Back")
        self.btn_back.setFont(QFont("Segoe UI, Inter", 10))
        self.btn_back.setStyleSheet("""
            QPushButton {
                background: #ffffff;
                color: #1d1d1f;
                border: 1px solid rgba(0, 0, 0, 0.15);
                border-radius: 8px;
                padding: 7px 20px;
            }
            QPushButton:hover { background: #f2f3f5; }
        """)
        self.btn_back.clicked.connect(self.prev_step)
        self.btn_back.hide()
        self.nav_bar.addWidget(self.btn_back)
        self.nav_bar.addStretch()

        self.btn_next = QPushButton("Continue")
        self.btn_next.setFont(QFont("Segoe UI, Inter", 10, QFont.Weight.DemiBold))
        self.btn_next.setStyleSheet("""
            QPushButton {
                background: #007aff;
                color: #ffffff;
                border: none;
                border-radius: 8px;
                padding: 7px 26px;
            }
            QPushButton:hover { background: #0066cc; }
            QPushButton:pressed { background: #0055b3; }
