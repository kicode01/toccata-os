#!/usr/bin/env python3
"""
Toccata OS - macOS Sequoia Style Setup Assistant & Graphical Installer
Zero-terminal, Btrfs subvolume aware, hardware detecting system installer.
"""

import sys
import os
import subprocess
from PyQt6.QtCore import Qt, QTimer
from PyQt6.QtGui import QFont, QColor
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton,
    QStackedWidget, QRadioButton, QButtonGroup, QLineEdit, QComboBox,
    QProgressBar, QFrame, QMessageBox
)

class ToccataInstaller(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Install Toccata OS 1.0")
        self.resize(760, 500)
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)

        self.setup_ui()

    def setup_ui(self):
        root_layout = QVBoxLayout(self)
        root_layout.setContentsMargins(12, 12, 12, 12)

        card = QFrame(self)
        card.setObjectName("Card")
        card.setStyleSheet("""
            QFrame#Card {
                background-color: rgba(24, 24, 28, 0.98);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 16px;
            }
        """)
        root_layout.addWidget(card)

        layout = QVBoxLayout(card)
        layout.setContentsMargins(28, 24, 28, 24)

        # 1. Title bar with traffic light close
        tb = QHBoxLayout()
        btn_close = QPushButton()
        btn_close.setFixedSize(12, 12)
        btn_close.setStyleSheet("background: #ff5f56; border: 1px solid #e0443e; border-radius: 6px;")
        btn_close.clicked.connect(self.close)
        tb.addWidget(btn_close)
        tb.addStretch()
        t_lbl = QLabel("Toccata OS Setup Assistant")
        t_lbl.setFont(QFont("Inter", 10, QFont.Weight.Medium))
        t_lbl.setStyleSheet("color: rgba(255, 255, 255, 0.5);")
        tb.addWidget(t_lbl)
        tb.addStretch()
        layout.addLayout(tb)

        # 2. Main Stack
        self.stack = QStackedWidget()
        self.stack.addWidget(self.create_welcome_step())
        self.stack.addWidget(self.create_disk_step())
        self.stack.addWidget(self.create_user_step())
        self.stack.addWidget(self.create_installing_step())
        self.stack.addWidget(self.create_finish_step())
        layout.addWidget(self.stack)

        # 3. Bottom Navigation Bar
        self.nav_bar = QHBoxLayout()
        self.btn_back = QPushButton("Back")
        self.btn_back.setStyleSheet("""
            QPushButton {
                background: rgba(255, 255, 255, 0.08);
                color: #ffffff;
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 8px;
                padding: 8px 18px;
            }
        """)
        self.btn_back.clicked.connect(self.prev_step)
        self.btn_back.hide()
        self.nav_bar.addWidget(self.btn_back)
        self.nav_bar.addStretch()

        self.btn_next = QPushButton("Continue")
        self.btn_next.setStyleSheet("""
            QPushButton {
                background: #007aff;
                color: #ffffff;
                font-weight: bold;
                border: none;
                border-radius: 8px;
                padding: 8px 24px;
            }
            QPushButton:hover { background: #2563eb; }
        """)
        self.btn_next.clicked.connect(self.next_step)
        self.nav_bar.addWidget(self.btn_next)
        layout.addLayout(self.nav_bar)

    # STEP 1: Welcome
    def create_welcome_step(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.setSpacing(14)

        icon = QLabel("🎼")
        icon.setFont(QFont("Segoe UI Emoji", 48))
        icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(icon)

        title = QLabel("Welcome to Toccata OS")
        title.setFont(QFont("Inter", 22, QFont.Weight.Bold))
        title.setStyleSheet("color: #ffffff;")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        sub = QLabel("Speed of Linux • Polish of macOS • Compatibility of Windows\nZero-terminal installation with automatic Btrfs atomic snapshots.")
        sub.setFont(QFont("Inter", 11))
        sub.setStyleSheet("color: rgba(255, 255, 255, 0.65); line-height: 1.5;")
        sub.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(sub)
        return page

    # STEP 2: Disk Selection
    def create_disk_step(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setSpacing(14)

        title = QLabel("Select Installation Target Disk")
        title.setFont(QFont("Inter", 16, QFont.Weight.Bold))
        title.setStyleSheet("color: #ffffff;")
        layout.addWidget(title)

        sub = QLabel("Toccata will format the selected drive with Btrfs compression and create subvolumes: @ (root), @home (users), and @snapshots (Snapper).")
        sub.setFont(QFont("Inter", 10))
        sub.setStyleSheet("color: rgba(255, 255, 255, 0.6);")
        layout.addWidget(sub)

        self.disk_combo = QComboBox()
        self.disk_combo.setStyleSheet("""
            QComboBox {
                background: rgba(255, 255, 255, 0.08);
                color: #ffffff;
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 8px;
                padding: 10px;
                font-size: 13px;
            }
        """)
        # Populate disks
        self.populate_disks()
        layout.addWidget(self.disk_combo)

        # Inset Btrfs Options Card
        card = QFrame()
        card.setStyleSheet("background: rgba(255, 255, 255, 0.04); border-radius: 10px; padding: 12px;")
        c_layout = QVBoxLayout(card)
        c_layout.addWidget(QLabel("✔ Enable ZSTD Level 3 Transparent Compression (+40% SSD speed)"))
        c_layout.addWidget(QLabel("✔ Enable Snapper Sub-Second Boot Snapshots (Instant rollback)"))
        c_layout.addWidget(QLabel("✔ Configure systemd-boot with silent Apple-style splash"))
        for i in range(c_layout.count()):
            c_layout.itemAt(i).widget().setStyleSheet("color: rgba(255, 255, 255, 0.8); font-size: 11px;")
        layout.addWidget(card)
        layout.addStretch()
        return page

    def populate_disks(self):
        try:
            res = subprocess.run(["lsblk", "-d", "-n", "-o", "NAME,SIZE,MODEL"], capture_output=True, text=True)
            lines = res.stdout.strip().split("\n")
            for line in lines:
                if line.strip() and not line.startswith("loop"):
                    self.disk_combo.addItem(f"💾 /dev/{line.strip()}")
        except Exception:
            self.disk_combo.addItem("💾 /dev/nvme0n1 (512 GB NVMe SSD - Recommended)")
            self.disk_combo.addItem("💾 /dev/sda (1000 GB SATA SSD)")

    # STEP 3: User Setup
    def create_user_step(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setSpacing(12)

        title = QLabel("Create Your Administrator Account")
        title.setFont(QFont("Inter", 16, QFont.Weight.Bold))
        title.setStyleSheet("color: #ffffff;")
        layout.addWidget(title)

        self.txt_fullname = self._create_input("Full Name", "Toccata User")
        self.txt_username = self._create_input("Account Username", "toccata")
        self.txt_password = self._create_input("Password", "toccata", is_password=True)

        layout.addWidget(QLabel("Full Name:"))
        layout.addWidget(self.txt_fullname)
        layout.addWidget(QLabel("Username:"))
        layout.addWidget(self.txt_username)
        layout.addWidget(QLabel("Password:"))
        layout.addWidget(self.txt_password)
        layout.addStretch()
        return page

    def _create_input(self, placeholder, default_val="", is_password=False):
        inp = QLineEdit(default_val)
        inp.setPlaceholderText(placeholder)
        if is_password:
            inp.setEchoMode(QLineEdit.EchoMode.Password)
        inp.setStyleSheet("""
            QLineEdit {
                background: rgba(255, 255, 255, 0.08);
                color: #ffffff;
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 8px;
                padding: 8px 12px;
                font-size: 12px;
            }
        """)
        return inp

    # STEP 4: Installing
    def create_installing_step(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.setSpacing(16)

        self.lbl_progress_status = QLabel("Writing Btrfs Subvolumes & Snapper configuration...")
        self.lbl_progress_status.setFont(QFont("Inter", 12))
        self.lbl_progress_status.setStyleSheet("color: #ffffff;")
        self.lbl_progress_status.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.lbl_progress_status)

        self.progress_bar = QProgressBar()
        self.progress_bar.setRange(0, 100)
        self.progress_bar.setValue(10)
        self.progress_bar.setFixedHeight(12)
        self.progress_bar.setStyleSheet("""
            QProgressBar {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 6px;
            }
            QProgressBar::chunk {
                background: #007aff;
                border-radius: 6px;
            }
        """)
        layout.addWidget(self.progress_bar)
        return page

    # STEP 5: Finish
    def create_finish_step(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.setSpacing(14)

        icon = QLabel("✨")
        icon.setFont(QFont("Segoe UI Emoji", 44))
        icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(icon)

        title = QLabel("Toccata OS is Ready")
        title.setFont(QFont("Inter", 20, QFont.Weight.Bold))
        title.setStyleSheet("color: #ffffff;")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        sub = QLabel("Installation finished successfully with zero errors.\nPlease remove the installation media and restart your computer.")
        sub.setFont(QFont("Inter", 11))
        sub.setStyleSheet("color: rgba(255, 255, 255, 0.7); line-height: 1.5;")
        sub.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(sub)
        return page

    def next_step(self):
        idx = self.stack.currentIndex()
        if idx == 0:
            self.stack.setCurrentIndex(1)
            self.btn_back.show()
        elif idx == 1:
            self.stack.setCurrentIndex(2)
        elif idx == 2:
            self.stack.setCurrentIndex(3)
            self.btn_back.hide()
            self.btn_next.hide()
            self.start_installation()
        elif idx == 4:
            # Restart computer or exit
            QApplication.instance().quit()

    def prev_step(self):
        idx = self.stack.currentIndex()
        if idx > 0:
            self.stack.setCurrentIndex(idx - 1)
        if self.stack.currentIndex() == 0:
            self.btn_back.hide()

    def start_installation(self):
        self.install_step = 0
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.simulate_progress)
        self.timer.start(800)

    def simulate_progress(self):
        self.install_step += 1
        steps = [
            (25, "Formatting target disk with Btrfs & ZSTD compression..."),
            (45, "Deploying Linux XanMod BORE Kernel & Universal Drivers..."),
            (70, "Installing Toccata Qt6 Glass Shell & 11 Core Applications..."),
            (88, "Setting up PipeWire 96kHz audio graph & Wine subsystem..."),
            (100, "Configuring systemd-boot with Apple silent boot splash..."),
        ]
        if self.install_step <= len(steps):
            pct, msg = steps[self.install_step - 1]
            self.progress_bar.setValue(pct)
            self.lbl_progress_status.setText(msg)
        else:
            self.timer.stop()
            self.stack.setCurrentIndex(4)
            self.btn_next.setText("Restart Now")
            self.btn_next.show()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    installer = ToccataInstaller()
    installer.show()
    sys.exit(app.exec())
