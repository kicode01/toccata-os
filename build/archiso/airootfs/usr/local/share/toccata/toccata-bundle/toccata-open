#!/usr/bin/env python3
"""
Toccata OS Application Bundle Launcher (`toccata-open`)
Optimized for low-latency bundle launching, metadata caching, and desktop integration.
"""

import sys
import os
import struct
import plistlib
import subprocess
import shutil
from pathlib import Path
from functools import lru_cache

# Mach-O Magic Numbers
MACHO_MAGICS = (0xfeedface, 0xcefaedfe, 0xfeedfacf, 0xcffaedfe, 0xcafebabe, 0xbebafeca)

def is_macho_binary(file_path: Path) -> bool:
    """Checks if the file has a Mach-O or FAT binary magic number."""
    if not file_path.is_file():
        return False
    try:
        with open(file_path, "rb") as f:
            header = f.read(4)
            if len(header) < 4:
                return False
            magic = struct.unpack(">I", header)[0]
            return magic in MACHO_MAGICS
    except Exception:
        return False

@lru_cache(maxsize=128)
def parse_info_plist_cached(plist_path_str: str) -> dict:
    """Cached parser for Info.plist files (binary, XML, or JSON format)."""
    plist_path = Path(plist_path_str)
    if not plist_path.is_file():
        return {}
    try:
        with open(plist_path, "rb") as f:
            return plistlib.load(f)
    except Exception as e:
        # Fallback simple key-value parser for minimal bundles
        data = {}
        try:
            with open(plist_path, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=", 1)
                        data[k.strip()] = v.strip().strip('"').strip("'")
        except Exception:
            pass
        return data

def launch_bundle(app_path: Path, args: list) -> int:
    """Executes the binary inside Contents/MacOS/ specified by Info.plist."""
    app_path = app_path.resolve()
    contents_dir = app_path / "Contents"
    info_plist = contents_dir / "Info.plist"
    macos_dir = contents_dir / "MacOS"

    if not contents_dir.is_dir() or not macos_dir.is_dir():
        print(f"[toccata-open] Error: '{app_path}' is not a valid .app bundle structure.", file=sys.stderr)
        return 1

    executable_name = None
    if info_plist.is_file():
        meta = parse_info_plist_cached(str(info_plist))
        executable_name = meta.get("CFBundleExecutable")

    # If CFBundleExecutable not specified, find the first executable in Contents/MacOS
    if not executable_name:
        for file in macos_dir.iterdir():
            if file.is_file():
                executable_name = file.name
                break

    if not executable_name:
        print(f"[toccata-open] Error: No executable found in {macos_dir}", file=sys.stderr)
        return 1

    exec_path = macos_dir / executable_name
    if not os.access(exec_path, os.X_OK):
        try:
            exec_path.chmod(exec_path.stat().st_mode | 0o111)
        except Exception:
            pass

    # Setup environment variables for bundle context
    env = os.environ.copy()
    env["TOCCATA_BUNDLE_PATH"] = str(app_path)
    env["TOCCATA_RESOURCES_PATH"] = str((contents_dir / "Resources").resolve())

    # Check if this bundle contains a Mach-O binary requiring Darling subsystem
    if is_macho_binary(exec_path):
        runner_script = Path(__file__).parent / "toccata-darling-runner.py"
        if runner_script.is_file():
            cmd = [sys.executable, str(runner_script), str(exec_path)] + args
            return subprocess.call(cmd)

    # Build command invocation
    # On Windows dev hosts, check for shebang or shell scripts to invoke via sh/bash or python
    if os.name == "nt":
        with open(exec_path, "rb") as f:
            header = f.readline().decode("utf-8", errors="ignore").strip()
        if header.startswith("#!/") and ("sh" in header or "bash" in header):
            git_bash = Path(r"C:\Program Files\Git\bin\bash.exe")
            sh_bin = shutil.which("sh") or shutil.which("bash") or (str(git_bash) if git_bash.exists() else "bash")
            cmd = [sh_bin, str(exec_path)] + args
        elif header.startswith("#!/") and "python" in header:
            cmd = [sys.executable, str(exec_path)] + args
        else:
            cmd = [str(exec_path)] + args
    else:
        cmd = [str(exec_path)] + args

    return subprocess.call(cmd, env=env)

def register_desktop_entry(app_path: Path):
    """Registers the .app bundle into Linux desktop menus (~/.local/share/applications)."""
    app_path = app_path.resolve()
    contents_dir = app_path / "Contents"
    info_plist = contents_dir / "Info.plist"
    if not info_plist.is_file():
        return

    meta = parse_info_plist_cached(str(info_plist))
    name = meta.get("CFBundleDisplayName") or meta.get("CFBundleName") or app_path.stem
    bundle_id = meta.get("CFBundleIdentifier", f"org.toccata.{app_path.stem.lower()}")
    
    icon_path = ""
    resources_dir = contents_dir / "Resources"
    if resources_dir.is_dir():
        for ext in [".png", ".svg", ".icns"]:
            icons = list(resources_dir.glob(f"*{ext}"))
            if icons:
                icon_path = str(icons[0].resolve())
                break

    desktop_dir = Path.home() / ".local" / "share" / "applications"
    desktop_dir.mkdir(parents=True, exist_ok=True)
    desktop_file = desktop_dir / f"{bundle_id}.desktop"

    desktop_content = f"""[Desktop Entry]
Type=Application
Name={name}
Exec=toccata-open "{app_path}" %U
Icon={icon_path}
Categories=Utility;
Terminal=false
StartupNotify=true
"""
    with open(desktop_file, "w", encoding="utf-8") as f:
        f.write(desktop_content)
    print(f"[toccata-open] Registered '{name}' desktop entry at {desktop_file}")

def main():
    if len(sys.argv) < 2:
        print("Usage: toccata-open <PathToApp.app> [--register] [args...]")
        sys.exit(1)

    target_path = Path(sys.argv[1])
    extra_args = sys.argv[2:]

    if "--register" in extra_args:
        extra_args.remove("--register")
        register_desktop_entry(target_path)

    sys.exit(launch_bundle(target_path, extra_args))

if __name__ == "__main__":
    main()
