#!/usr/bin/env python3
"""
Toccata OS Native Application Launcher: Scribe
Dual-track architecture: Launches optimized upstream Linux desktop engine if available,
or falls back seamlessly to Toccata's integrated Python/Qt6 engine.
"""

import sys
import os
import shutil
import subprocess

PRIMARY_CANDIDATES = ['gnome-text-editor', 'gedit', 'kate', 'mousepad']
TOCCATA_FALLBACK = "/usr/local/share/toccata/toccata-shell/apps/scribe.py"

def main():
    args = sys.argv[1:]
    
    # 1. Try native upstream desktop packages
    for binary in PRIMARY_CANDIDATES:
        bin_path = shutil.which(binary)
        if bin_path:
            os.execv(bin_path, [binary] + args)
            
    # 2. Try integrated Toccata Python engine
    if os.path.exists(TOCCATA_FALLBACK):
        python_bin = shutil.which("python3") or "/usr/bin/python3"
        os.execv(python_bin, ["python3", TOCCATA_FALLBACK] + args)
        
    print(f"[-] Error: Could not locate execution engine for Scribe.", file=sys.stderr)
    print(f"    Searched: {PRIMARY_CANDIDATES} and {TOCCATA_FALLBACK}", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
